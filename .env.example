# Copy this file to .env and fill in real values before running the app.

# SQLite for local dev — this exact value works with zero setup.
# To move to Postgres later: change the provider in prisma/schema.prisma
# to "postgresql" and put a real connection string here instead.
DATABASE_URL="file:./dev.db"

# Used once by `npm run db:seed` to create the first admin account.
# Change these before seeding — they are not read anywhere else.
ADMIN_EMAIL="you@noble.example.com"
ADMIN_PASSWORD="change-this-before-seeding"
